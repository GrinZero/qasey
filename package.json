{
  "name": "moego-qasey",
  "version": "0.1.0",
  "private": true,
  "description": "Qasey QA agent migrated from n8n to Mastra",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "mastra dev --dir src/mastra",
    "dev:slack": "tsx apps/api/src/slack-receiver.ts",
    "dev:worker": "tsx apps/worker/src/worker.ts",
    "mcp:login": "tsx apps/cli/src/mcp-login.ts",
    "start": "MASTRA_STUDIO_PATH=.mastra/output/studio node .mastra/output/index.mjs",
    "start:slack": "node dist/slack-receiver.mjs",
    "start:worker": "node dist/worker.mjs",
    "build": "tsup && mastra build --dir src/mastra --studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "demo:web": "vitest run tests/e2e/playwright-runner.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.28",
    "@mastra/acp": "0.4.0",
    "@mastra/auth-google": "0.1.0",
    "@mastra/core": "1.58.0",
    "@mastra/datadog": "1.3.9",
    "@mastra/duckdb": "1.6.1",
    "@mastra/editor": "0.13.12",
    "@mastra/mcp": "1.16.0",
    "@mastra/memory": "1.26.1",
    "@mastra/observability": "1.16.6",
    "@mastra/pg": "1.20.0",
    "@octokit/rest": "^22.0.0",
    "@playwright/test": "1.62.1",
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^7.10.0",
    "dd-trace": "5.117.0",
    "dotenv": "^17.4.2",
    "pg": "^8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "mastra": "1.24.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
