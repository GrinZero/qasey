{
  "name": "qasey",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Qasey on the shared native Mastra runtime",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "sh scripts/bootstrap.sh",
    "dev": "tsx scripts/dev.ts",
    "dev:container": "tsx scripts/dev.ts --external-sandbox",
    "infra:up": "docker compose up -d --wait postgres redis",
    "infra:down": "docker compose down",
    "compose:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build -d",
    "compose:dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "compose:runtime": "docker compose -f docker-compose.yml -f docker-compose.runtime.yml up --build -d",
    "compose:runtime:down": "docker compose -f docker-compose.yml -f docker-compose.runtime.yml down",
    "public:snapshot": "node scripts/create-public-snapshot.mjs",
    "check:public-history": "node scripts/check-public-history.mjs",
    "mcp:login": "tsx apps/cli/src/mcp-login.ts",
    "start": "sh ci/runtime.sh api",
    "admin-ui:build": "pnpm --dir apps/admin-ui build",
    "admin-ui:test": "pnpm --dir apps/admin-ui test",
    "test:browser": "pnpm admin-ui:build && playwright test --config=playwright.config.ts",
    "build": "tsx scripts/write-build-metadata.ts && pnpm db:generate && pnpm admin-ui:build && tsup && mastra build --dir src/mastra --studio && mastra worker build --dir src/mastra --output-dir .mastra/worker && node scripts/copy-mastra-skills.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dr:backup": "node --import tsx scripts/disaster-recovery.ts backup",
    "dr:restore": "node --import tsx scripts/disaster-recovery.ts restore",
    "dr:verify": "node --import tsx scripts/disaster-recovery.ts verify",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "pretest": "pnpm admin-ui:build",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "evals:validate": "vitest run tests/evals/public-dataset.test.ts",
    "evals:gate:live": "node --import tsx evals/public/check-live-report.ts",
    "check:open-source": "node scripts/check-open-source.mjs",
    "check:native-code-task": "node scripts/check-native-code-task.mjs",
    "check:licenses": "node scripts/check-license-policy.mjs",
    "check": "pnpm check:open-source && pnpm check:native-code-task && pnpm check:licenses && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.101",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@chat-adapter/slack": "4.37.0",
    "@mastra/core": "1.59.0",
    "@mastra/datadog": "1.4.0",
    "@mastra/duckdb": "1.6.1",
    "@mastra/mcp": "1.16.0",
    "@mastra/memory": "1.26.2",
    "@mastra/observability": "1.17.0",
    "@mastra/pg": "1.20.0",
    "@mastra/quickjs": "0.1.0",
    "@mastra/redis": "1.4.0",
    "@mastra/redis-streams": "0.3.0",
    "@octokit/rest": "^22.0.0",
    "@playwright/test": "1.62.1",
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.2.0",
    "@prisma/client-runtime-utils": "7.2.0",
    "@slack/web-api": "^7.10.0",
    "@trycua/cua-driver": "0.21.0",
    "chat": "4.37.0",
    "dd-trace": "5.117.0",
    "ioredis": "6.0.0",
    "jose": "6.2.8",
    "pg": "^8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "mastra": "1.25.0",
    "prisma": "7.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
