{
  "name": "figma_list_pages",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "file_key"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.figma.com/v1/files/{{ $json.file_key }}?depth=1",
        "authentication": "genericCredentialType",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "fetch_file",
      "name": "Fetch Figma File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "1GVlPTDvNkM2MRoV",
          "name": "Figma PAT"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "/**\n * figma_list_pages — 提取文件所有页面\n * 输入: Figma GET /v1/files/:key?depth=1 响应\n * 输出: [{ json: { file_name, pages: [{id, name}] } }]\n */\n\nconst input = $input.first().json;\nconst document = input.document || {};\nconst pages = (document.children || []).map(page => ({\n  id: page.id,\n  name: page.name || '(unnamed)',\n}));\n\nreturn [{\n  json: {\n    file_name: input.name || '',\n    file_last_modified: input.lastModified || '',\n    pages,\n  }\n}];\n"
      },
      "id": "format_pages",
      "name": "Format Pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "Fetch Figma File": {
      "main": [
        [
          {
            "node": "Format Pages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Fetch Figma File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}