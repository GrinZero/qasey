{
  "name": "figma_export_image",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "file_key"
            },
            {
              "name": "node_ids"
            },
            {
              "name": "format"
            },
            {
              "name": "scale"
            }
          ]
        }
      },
      "id": "trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.figma.com/v1/images/{{ $json.file_key }}?ids={{ $json.node_ids }}&format={{ $json.format || 'png' }}&scale={{ $json.scale || 2 }}",
        "authentication": "genericCredentialType",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        },
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "export_images",
      "name": "Export Images",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "1GVlPTDvNkM2MRoV",
          "name": "Figma PAT"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "/**\n * figma_export_image — 格式化导出结果\n * 输入: Figma GET /v1/images/:key 响应\n * 输出: [{ json: { images: [{node_id, image_url}] } }]\n */\n\nconst input = $input.first().json;\nconst imagesMap = input.images || {};\n\nconst images = Object.entries(imagesMap).map(([nodeId, url]) => ({\n  node_id: nodeId,\n  image_url: url,\n  available: url !== null,\n}));\n\nreturn [{\n  json: {\n    images,\n    format: $('When Executed by Another Workflow').first().json.format || 'png',\n    scale: $('When Executed by Another Workflow').first().json.scale || 2,\n    note: 'Image URLs expire after 30 days',\n  }\n}];\n"
      },
      "id": "format_images",
      "name": "Format Images",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "Export Images": {
      "main": [
        [
          {
            "node": "Format Images",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Export Images",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}