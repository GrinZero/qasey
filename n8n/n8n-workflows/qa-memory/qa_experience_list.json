{
  "name": "qa_experience_list",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "parent",
              "type": "string"
            },
            {
              "name": "page_token",
              "type": "string"
            }
          ]
        }
      },
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "id": "qa-list-trigger"
    },
    {
      "parameters": {
        "jsCode": "PLACEHOLDER_RESOLVE"
      },
      "name": "Resolve Target",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "id": "qa-list-resolve"
    },
    {
      "parameters": {
        "url": "=https://open.feishu.cn/open-apis/wiki/v2/spaces/get_node?token={{ $json.target_token }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "Get Node",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "id": "qa-list-getnode",
      "credentials": {
        "oAuth2Api": {
          "id": "JtPRQHOwJYD5CYex",
          "name": "Feishu User OAuth2 v3 offline_access"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "url": "=https://open.feishu.cn/open-apis/wiki/v2/spaces/{{ $json.data?.node?.space_id || 'unresolved' }}/nodes?parent_node_token={{ $json.data?.node?.node_token || 'unresolved' }}&page_size=50{{ $('Resolve Target').first().json.page_token ? '&page_token=' + $('Resolve Target').first().json.page_token : '' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "name": "List Children",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "id": "qa-list-children",
      "credentials": {
        "oAuth2Api": {
          "id": "JtPRQHOwJYD5CYex",
          "name": "Feishu User OAuth2 v3 offline_access"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "PLACEHOLDER_FORMAT"
      },
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0],
      "id": "qa-list-format"
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [[{ "node": "Resolve Target", "type": "main", "index": 0 }]]
    },
    "Resolve Target": {
      "main": [[{ "node": "Get Node", "type": "main", "index": 0 }]]
    },
    "Get Node": {
      "main": [[{ "node": "List Children", "type": "main", "index": 0 }]]
    },
    "List Children": {
      "main": [[{ "node": "Format", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "tags": []
}
