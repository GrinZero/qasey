{
  "display_information": {
    "name": "Qasey",
    "description": "A self-hosted QA agent",
    "background_color": "#845ce0"
  },
  "features": {
    "bot_user": {
      "display_name": "Qasey",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "user": [
        "search:read"
      ],
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "channels:history",
        "channels:read",
        "chat:write",
        "chat:write.public",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "reactions:write",
        "users.profile:read",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://qasey.example.com/channels/slack/apps/replace-with-webhook-id/events",
      "bot_events": [
        "app_mention",
        "app_home_opened",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://qasey.example.com/channels/slack/apps/replace-with-webhook-id/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
