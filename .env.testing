# moego-server-cluster-development / ns-testing
NODE_ENV=production
QASEY_PUBLIC_BASE_URL=https://qasey.t2.moego.dev
GOOGLE_REDIRECT_URI=https://qasey.t2.moego.dev/auth/google/callback

# Testing-only bridge used by local `pnpm dev` runtimes. The credential is
# injected from Secrets Manager; local development receives it through the
# same standard environment loader.
QASEY_DEV_TUNNEL_ENABLED=true
QASEY_DEV_TUNNEL_BASE_URL=https://qasey.t2.moego.dev

# PostgreSQL 连接参数是环境配置；只有密码由 AWS Secrets Manager 注入。
PG_URL=testing-postgres-aurora.cluster-cmv9c9tztifm.us-west-2.rds.amazonaws.com
PG_PORT=5432
PG_QASEY_USER_NAME=moego_developer_240310_eff7a0dc

# T2 暴露 Mastra Studio：Editor 与只读 MCP preview 均开启。
QASEY_ENABLE_STUDIO_EDITOR=true
QASEY_ENABLE_STUDIO_MCP_PREVIEW=true

QASEY_SANDBOX_ENDPOINT_TEMPLATE=http://moego-qasey-sandbox-{ordinal}.moego-qasey-sandbox:4120
QASEY_SANDBOX_REPLICAS=2
QASEY_SANDBOX_MAX_SESSIONS=5

QASEY_ENABLE_DATADOG=true
QASEY_DATADOG_CAPTURE_CONTENT=true
DD_LLMOBS_ML_APP=qasey
DD_LLMOBS_AGENTLESS_ENABLED=false
DD_ENV=ns-testing
DD_SITE=us5.datadoghq.com
DD_TRACE_ENABLED=true
DD_TRACE_SAMPLE_RATE=1
DD_LOGS_INJECTION=true
DD_RUNTIME_METRICS_ENABLED=true

QASEY_DATA_ROOT=/app/.qasey/data
QASEY_WORKSPACE_DIR=/app/.qasey/data/workspaces
QASEY_GIT_CACHE_DIR=/app/.qasey/data/git-cache
QASEY_ARTIFACT_DIR=/app/.qasey/data/artifacts
