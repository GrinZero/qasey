# Qasey 各环境共用的非敏感配置。
# 本机覆盖写入 .env.local；环境差异写入 .env.<namespace>；凭据由 .env.secret 提供。
OPENAI_BASE_URL=https://sub2api.devops.moego.dev/v1

# Google OAuth client id 是公开标识；client secret 与 cookie password
# 由 AWS Secrets Manager 注入。
GOOGLE_CLIENT_ID=454068184103-s8ki74gsu828unusd57ufn55e4hu1ig7.apps.googleusercontent.com
PLATFORM_BOOTSTRAP_ADMIN_EMAILS=jiabowang@moego.pet
GOOGLE_ALLOWED_DOMAINS=moego.pet
GOOGLE_HOSTED_DOMAIN=moego.pet

QASEY_AGENT_TIMEOUT_MS=1800000

QASEY_MEMORY_MODEL=gpt-5.6-luna
QASEY_MEMORY_MESSAGE_TOKENS=30000
QASEY_MEMORY_OBSERVATION_TOKENS=40000
QASEY_MEMORY_INPUT_TOKEN_LIMIT=120000

SLACK_BOT_USER_ID=U0BMP1SGB40
JIRA_BASE_URL=https://moego.atlassian.net/
JIRA_EMAIL=jiraragservice-bug-pujml5gdfb@serviceaccount.atlassian.com

# GitHub App identifiers are public. Override them in .env.<namespace> when
# environments use different installations; the PEM private key stays secret.
GITHUB_APP_ID=1485004
GITHUB_APP_INSTALLATION_ID=73660683

# Editor 当前未在部署环境启用；启用时在 .env.<namespace> 中覆盖数据库地址。
EDITOR_DATABASE_URL=

# PostgreSQL host/port/username live in .env.<namespace>; only the password comes
# from AWS Secrets Manager. Both logical databases share one instance.
PG_QASEY_DATABASE_NAME=moego_qasey
PG_QASEY_OBSERVABILITY_DATABASE_NAME=moego_qasey_observability

# OAuth token 本身不进入该文件；这里只指定 MCP catalogue 的位置。
QASEY_MCP_CONFIG_FILE=/app/.qasey/mcp.json
METERSPHERE_BASE_URL=https://metersphere.devops.moego.pet
METERSPHERE_PROJECT_ID=20a78db9-19aa-11ee-a261-5a66b98c4036

QASEY_ACP_COMMAND=codex-acp
QASEY_ACP_ARGS=
QASEY_MAX_REPAIRS=2

REDIS_TLS=true
