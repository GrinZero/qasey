# Copy this file to .env.secret and fill in only the credentials you need.
# .env.secret is gitignored and overrides matching values from .env locally.
# Put machine-specific overrides in .env.local; it has the highest file priority.

# Databases and model provider. Local database URLs belong in .env.local.
DATABASE_URL=
OBSERVABILITY_DATABASE_URL=
# Deployment derives both URLs from checked-in PostgreSQL connection parameters
# plus the environment-specific password below.
PG_QASEY_PASSWORD=
OPENAI_API_KEY=

# Mastra distributed PubSub. Deployment values are loaded from
# moego/<environment>/redis; REDIS_USERNAME is only needed for a non-default ACL user.
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=true

# Platform-owned Google OAuth/OIDC session and service authentication
GOOGLE_CLIENT_SECRET=
# Use an independently generated value of at least 32 characters in every environment.
GOOGLE_COOKIE_PASSWORD=
PLATFORM_SERVICE_TOKEN=replace-me
WORKER_TOKEN=replace-with-a-dedicated-mastra-worker-token

# Slack
# auto selects Socket Mode outside production when an app-level token exists.
SLACK_CHANNEL_MODE=auto
SLACK_BOT_TOKEN=
# User OAuth token with search:read; required only for Slack message search.
SLACK_USER_TOKEN=
SLACK_SIGNING_SECRET=
# Optional for local development only. HTTP Events API is the production default.
SLACK_SOCKET_MODE_APP_TOKEN=

# Testing-only credential for the outbound local Runtime tunnel. Keep it
# distinct from platform, worker, and local API authentication tokens.
QASEY_DEV_TUNNEL_TOKEN=

# Optional integrations
JIRA_API_TOKEN=
JIRA_WEBHOOK_TOKEN=
GITHUB_APP_PRIVATE_KEY=

# Shared by the n8n-hosted MeterSphere, Figma, QA Experience, and Lark Bearer endpoints.
QASEY_N8N_MCP_TOKEN=
# MoeGo RAG uses a separate service credential.
MOEGO_RAG_MCP_TOKEN=

# Production OAuth refresh tokens are encrypted in Postgres with this key.
# Local development uses gitignored, mode-0600 files under .qasey/oauth when this is absent.
MASTRA_ENCRYPTION_KEY=
