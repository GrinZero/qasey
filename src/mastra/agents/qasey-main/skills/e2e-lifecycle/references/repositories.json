{
  "version": 1,
  "web": {
    "target": {
      "owner": "MoeGolibrary",
      "repository": "moego-e2e-autotest",
      "cloneUrl": "https://github.com/MoeGolibrary/moego-e2e-autotest.git",
      "baseRef": "main",
      "allowedPaths": [
        "project/BWeb/tests",
        "project/BWeb/pages",
        "project/BWeb/utils",
        "project/OBC/tests",
        "project/OBC/pages",
        "project/OBC/utils",
        "project/OBC/helpers",
        "project/enterprise/tests",
        "project/enterprise/pages"
      ],
      "skillsPaths": [".agents/skills", ".claude/skills", "skills"]
    },
    "verification": {
      "strategy": "changed-project-playwright",
      "projects": [
        {
          "id": "bweb",
          "root": "project/BWeb",
          "testRoot": "project/BWeb/tests",
          "config": "project/BWeb/playwright.config.ts",
          "playwrightProject": "t2"
        },
        {
          "id": "obc",
          "root": "project/OBC",
          "testRoot": "project/OBC/tests",
          "config": "project/OBC/playwright.config.ts",
          "playwrightProject": "t2"
        },
        {
          "id": "enterprise",
          "root": "project/enterprise",
          "testRoot": "project/enterprise/tests",
          "config": "project/enterprise/playwright.config.ts",
          "playwrightProject": "t2"
        }
      ]
    },
    "contextRepositories": [
      { "owner": "MoeGolibrary", "repository": "Boarding_Desktop", "mode": "read", "clone": "on-demand" }
    ]
  },
  "app": {
    "status": "deferred",
    "target": { "owner": "MoeGolibrary", "repository": "moego-mobile-e2e" }
  }
}
