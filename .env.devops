# moego-server-cluster-devops / ns-devops（预留，当前不部署）
NODE_ENV=production
QASEY_PUBLIC_BASE_URL=https://qasey.devops.moego.pet
GOOGLE_REDIRECT_URI=https://qasey.devops.moego.pet/auth/google/callback
QASEY_DEV_TUNNEL_ENABLED=false

# PostgreSQL 连接参数是环境配置；只有密码由 AWS Secrets Manager 注入。
PG_URL=moego-postgres-devops.cluster-cmv9c9tztifm.us-west-2.rds.amazonaws.com
PG_PORT=5432
PG_QASEY_USER_NAME=moego_qasey

# Studio UI 由 Google OAuth、RBAC 与审计保护；Editor 保持关闭，MCP preview 以只读模式开启。
QASEY_ENABLE_STUDIO_EDITOR=false
QASEY_ENABLE_STUDIO_MCP_PREVIEW=true

QASEY_SHADOW_MODE=false
QASEY_ENABLE_EXECUTION=false
QASEY_ENABLE_DRAFT_PR=false
QASEY_ENABLE_CUA_FALLBACK=false

QASEY_ENABLE_DATADOG=true
QASEY_DATADOG_CAPTURE_CONTENT=true
DD_LLMOBS_ML_APP=qasey
DD_ENV=ns-devops
DD_SITE=us5.datadoghq.com
DD_TRACE_ENABLED=true
DD_TRACE_SAMPLE_RATE=1
DD_LOGS_INJECTION=true
DD_RUNTIME_METRICS_ENABLED=true

QASEY_DATA_ROOT=/app/.qasey/data
QASEY_WORKSPACE_DIR=/app/.qasey/data/workspaces
QASEY_GIT_CACHE_DIR=/app/.qasey/data/git-cache
QASEY_ARTIFACT_DIR=/app/.qasey/data/artifacts
