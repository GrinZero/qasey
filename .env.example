NODE_ENV=development
DATABASE_URL=postgresql://qasey:qasey@localhost:5432/qasey
# Production Editor and observability must use dedicated databases. Local
# development intentionally uses filesystem + DuckDB, so leave these unset.
# EDITOR_DATABASE_URL=postgresql://qasey:secret@postgres/qasey_editor
# OBSERVABILITY_DATABASE_URL=postgresql://qasey:secret@postgres/qasey_observability
OPENAI_API_KEY=

# Production observability: keep MastraStorageExporter for Studio and enable
# DatadogBridge for APM + LLM Observability. Agent mode expects a local
# Datadog Agent; no DD_API_KEY belongs in the Qasey container.
QASEY_ENABLE_DATADOG=false
QASEY_DATADOG_CAPTURE_CONTENT=false
# DD_LLMOBS_ML_APP=qasey
# DD_SERVICE=qasey-worker
# DD_ENV=production
# DD_VERSION=
# DD_AGENT_HOST=127.0.0.1

# Start in shadow mode: no Slack/Jira/MeterSphere/GitHub writes.
QASEY_SHADOW_MODE=true
QASEY_ENABLE_EXECUTION=false
QASEY_ENABLE_DRAFT_PR=false
QASEY_ENABLE_CUA_FALLBACK=false
QASEY_PUBLIC_BASE_URL=http://localhost:4111
# Google OAuth/OIDC. Optional for local development, required in production.
# Register http://localhost:4111/api/auth/sso/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4111/api/auth/sso/callback
# Use an independently generated value of at least 32 characters in every environment.
GOOGLE_COOKIE_PASSWORD=
# Optional comma-separated Google Workspace allowlist, for example: moego.pet,moego.com
GOOGLE_ALLOWED_DOMAINS=
# Optional login hint; authorization is enforced by GOOGLE_ALLOWED_DOMAINS, not this value.
GOOGLE_HOSTED_DOMAIN=
# Mastra browser-based SSO is an Enterprise feature in production.
MASTRA_LICENSE_KEY=
QASEY_INGRESS_TOKEN=replace-me
QASEY_JOB_HEARTBEAT_MS=15000
QASEY_JOB_LEASE_MS=90000
QASEY_AGENT_TIMEOUT_MS=600000

# Mastra Observational Memory. The fast background model observes raw history,
# reflects accumulated observations, and keeps the actor context bounded.
QASEY_MEMORY_MODEL=gpt-5.4-mini
QASEY_MEMORY_MESSAGE_TOKENS=30000
QASEY_MEMORY_OBSERVATION_TOKENS=40000
QASEY_MEMORY_INPUT_TOKEN_LIMIT=120000

SLACK_BOT_TOKEN=
# User OAuth token with search:read; required only for Slack message search.
SLACK_USER_TOKEN=
SLACK_SIGNING_SECRET=
# Optional for local development only. HTTP Events API is the production default.
SLACK_SOCKET_MODE_APP_TOKEN=
SLACK_BOT_USER_ID=U0BMP1SGB40

# Optional integrations. Leave them absent until that trigger/capability is enabled.
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_WEBHOOK_TOKEN=
# GITHUB_TOKEN=

# Remote MCP endpoints and auth modes live in this JSON file. OAuth tokens do not.
# Copy config/mcp.example.json to .qasey/mcp.json only when enabling MCP tools.
QASEY_MCP_CONFIG_FILE=.qasey/mcp.json
# QASEY_ENABLE_STUDIO_EDITOR=true
# QASEY_ENABLE_STUDIO_MCP_PREVIEW=true
# Shared by the n8n-hosted MeterSphere, Figma, QA Experience, and Lark Bearer endpoints.
# QASEY_N8N_MCP_TOKEN=
# MoeGo RAG uses a separate service credential.
# MOEGO_RAG_MCP_TOKEN=
# Production OAuth refresh tokens are encrypted in Postgres with this key.
# Local development uses gitignored, mode-0600 files under .qasey/oauth when this is absent.
# MASTRA_ENCRYPTION_KEY=

QASEY_ACP_COMMAND=codex-acp
QASEY_ACP_ARGS=
QASEY_WORKSPACE_DIR=.qasey/workspaces
QASEY_ARTIFACT_DIR=.qasey/artifacts
QASEY_MAX_REPAIRS=2
