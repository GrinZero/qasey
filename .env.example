# Copy to .env for local development. Never commit real credentials or tenant data.
NODE_ENV=development
QASEY_DEPLOYMENT_MODE=standalone
# Stable across every replica in one deployment; separates shared Redis keys.
QASEY_DEPLOYMENT_ID=
# Unique per process/replica; used only for operational attribution.
QASEY_INSTANCE_ID=
# Production requires the promoted immutable image digest or release identifier.
DD_VERSION=
QASEY_PUBLIC_BASE_URL=http://localhost:4111
# Optional comma-separated exact origins used only for intentional internal
# browser/test aliases. Do not use wildcards.
QASEY_ADDITIONAL_TRUSTED_ORIGINS=
# Host port published by the full local Docker Compose stack.
QASEY_APP_PORT=4111
GOOGLE_REDIRECT_URI=http://localhost:4111/auth/google/callback

# PostgreSQL. A standard PostgreSQL URL works; Supabase is optional.
# For Supabase use its direct or session-pooler URL for this persistent service.
QASEY_POSTGRES_PORT=5432
QASEY_REDIS_PORT=6379
# Local Compose-only database password. Use a secret manager in production.
QASEY_POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qasey
# Development observability defaults to local DuckDB when this is empty.
OBSERVABILITY_DATABASE_URL=

# Model provider
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
QASEY_MEMORY_MODEL=gpt-5.6-luna
QASEY_MAIN_MODEL=gpt-5.6-sol
# Optional deployment-specific rates; set both together (micro-USD per token).
# QASEY_MODEL_INPUT_COST_MICROUSD_PER_TOKEN=1.25
# QASEY_MODEL_OUTPUT_COST_MICROUSD_PER_TOKEN=10
QASEY_CODE_AGENT_MODEL=gpt-5.6-sol

# Browser login. Single-tenant deployments enable password login and signup by
# default in every environment, including production. Set either flag to false
# to opt out; complete Google OIDC remains available as an additional provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_COOKIE_PASSWORD=
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_HOSTED_DOMAIN=
QASEY_PASSWORD_AUTH_ENABLED=true
QASEY_PASSWORD_REGISTRATION_ENABLED=true
# Development only: comma-separated local password accounts that become platform admins.
PLATFORM_LOCAL_ADMIN_EMAILS=

# Envelope-encryption keyring for tenant integration credentials. During a
# rotation, change the active ID/key and retain old ID/key pairs in the JSON map
# until every connection has been rotated through the management API.
QASEY_CREDENTIAL_ENCRYPTION_KEY=
QASEY_CREDENTIAL_ACTIVE_KEY_ID=default
# QASEY_CREDENTIAL_PREVIOUS_KEYS={"default":"previous-key-with-at-least-32-bytes"}

# Local API access for scripts; generate with: openssl rand -hex 32
QASEY_DEV_AUTH_TOKEN=

# Platform traffic governance. Distributed replicas share Redis counters and
# concurrency leases; standalone uses process-local counters.
QASEY_REQUEST_BODY_MAX_BYTES=1048576
QASEY_STANDARD_TENANT_REQUESTS_PER_MINUTE=6000
QASEY_STANDARD_SUBJECT_REQUESTS_PER_MINUTE=600
QASEY_EXPENSIVE_TENANT_REQUESTS_PER_MINUTE=60
QASEY_EXPENSIVE_SUBJECT_REQUESTS_PER_MINUTE=10
QASEY_EXPENSIVE_TENANT_CONCURRENCY=4
QASEY_EXPENSIVE_LEASE_TTL_MS=3600000

# Optional integrations
SLACK_CHANNEL_MODE=auto
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_SOCKET_MODE_APP_TOKEN=
SLACK_BOT_USER_ID=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_TOKEN=
JIRA_QASEY_ACCOUNT_ID=qasey
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_WEBHOOK_SECRET=
# MCP servers are opt-in. Static bearer config is single-tenant only; multi-tenant
# bearer credentials belong in encrypted provider=mcp external connections.
QASEY_MCP_CONFIG_FILE=config/mcp.json
QASEY_MCP_BEARER_TOKEN=

# E2E code generation is disabled until this file is created from the example.
QASEY_E2E_REPOSITORY_CONFIG_FILE=config/e2e-repository.json
# Stable target-owned dogfood account. Create it once in the configured test
# tenant; Qasey and CI log in but never register or rotate it automatically.
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=
E2E_TEST_TENANT_ID=
# OAuth MCP tokens have a separate versioned keyring. Roll out reader support
# first, then change the active ID/key while retaining `default` and any older
# generations until startup CAS re-encryption has completed on every replica.
MASTRA_ENCRYPTION_KEY=
MASTRA_ENCRYPTION_ACTIVE_KEY_ID=default
# MASTRA_ENCRYPTION_PREVIOUS_KEYS={"default":"previous-oauth-key-with-at-least-32-bytes"}

# Local paths and feature flags
QASEY_DATA_ROOT=.qasey/data
QASEY_WORKSPACE_DIR=.qasey/workspaces
QASEY_GIT_CACHE_DIR=.qasey/git-cache
QASEY_ARTIFACT_DIR=.qasey/artifacts
QASEY_ENABLE_CODE_MODE=false
QASEY_ENABLE_LOCAL_CODE_MODE=false
QASEY_ENABLE_DATADOG=false
QASEY_USE_REDIS_DURABILITY=false

# Distributed production additionally requires WORKER_TOKEN, Redis, and a
# remote sandbox pool. The container maps WORKER_TOKEN to Mastra's standard
# MASTRA_WORKER_AUTH_TOKEN for the worker process. PLATFORM_SERVICE_TOKEN is
# optional; every bearer token below must contain at least 32 UTF-8 bytes and
# remain distinct from worker, tunnel, webhook, and metrics credentials. See
# docs/deployment.md.
WORKER_TOKEN=
# Worker probes use a separate private listener; production metrics require
# their own Bearer token rather than reusing WORKER_TOKEN.
QASEY_WORKER_HEALTH_PORT=8081
QASEY_WORKER_METRICS_TOKEN=
QASEY_WORKER_HEARTBEAT_TIMEOUT_MS=15000
PLATFORM_SERVICE_TOKEN=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
QASEY_SANDBOX_ENDPOINT_TEMPLATE=
# Development may use none. Production Sandbox startup always requires bwrap;
# container/VM isolation and network policy remain additional boundaries.
QASEY_SANDBOX_ISOLATION=none
# Development default is 5. Production requires exactly one untrusted session
# per Sandbox process/pod; scale Sandbox replicas for concurrency.
QASEY_SANDBOX_MAX_SESSIONS=5
QASEY_SANDBOX_EGRESS_PROXY_URL=
QASEY_SANDBOX_BROWSER_ALLOWED_ORIGINS=
