# 复制为 .env.local 后按本机需要调整。该文件只描述本地覆盖，不进入镜像。
NODE_ENV=development
# Local Docker Redis is plaintext and has no password by default. These values
# must override the TLS-enabled testing environment.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Optional: point these at databases that already exist. This repository does not
# start or initialize a local PostgreSQL instance.
# DATABASE_URL=
# OBSERVABILITY_DATABASE_URL=
QASEY_PUBLIC_BASE_URL=http://localhost:4111
GOOGLE_REDIRECT_URI=http://localhost:4111/auth/google/callback
# Prefer Slack Socket Mode for local development; no public webhook is needed.
SLACK_CHANNEL_MODE=auto

QASEY_SHADOW_MODE=false
QASEY_ENABLE_EXECUTION=false
QASEY_ENABLE_DRAFT_PR=true
QASEY_ENABLE_CUA_FALLBACK=false
QASEY_ENABLE_DATADOG=false
QASEY_DATADOG_CAPTURE_CONTENT=false

QASEY_MCP_CONFIG_FILE=.qasey/mcp.json
QASEY_WORKSPACE_DIR=.qasey/workspaces
QASEY_ARTIFACT_DIR=.qasey/artifacts

NAMESPACE=ns-testing
AWS_REGION=us-west-2
AWS_PROFILE=moego-development
# 无法使用 Profile 时才填写：
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
