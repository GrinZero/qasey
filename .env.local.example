# 复制为 .env.local 后按本机需要调整。该文件只描述本地覆盖，不进入镜像。
NODE_ENV=development
# Optional local-user authentication for curl, API clients, and regression
# probes. Generate a value with `openssl rand -hex 32`; never commit the real
# token. Authentication ignores it in tests and production rejects it.
# QASEY_DEV_AUTH_TOKEN=
# Local Docker Redis is plaintext and has no password by default. These values
# must override the TLS-enabled testing environment.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Optional: point these at databases that already exist. This repository does not
# start or initialize a local PostgreSQL instance.
# DATABASE_URL=
# Development uses local DuckDB observability by default. Set this only when a
# remote observability database is intentionally needed for local debugging.
# OBSERVABILITY_DATABASE_URL=
QASEY_PUBLIC_BASE_URL=http://localhost:4111
GOOGLE_REDIRECT_URI=http://localhost:4111/auth/google/callback
# Prefer Slack Socket Mode for local development; no public webhook is needed.
SLACK_CHANNEL_MODE=auto

QASEY_SHADOW_MODE=false
QASEY_ENABLE_EXECUTION=false
QASEY_ENABLE_DRAFT_PR=true
QASEY_ENABLE_CUA_FALLBACK=false
QASEY_ENABLE_CODE_MODE=true
QASEY_CODE_MODE_TIMEOUT_MS=180000
QASEY_CODE_MODE_MEMORY_LIMIT_MB=128
QASEY_ENABLE_DATADOG=false
QASEY_DATADOG_CAPTURE_CONTENT=false

QASEY_MCP_CONFIG_FILE=.qasey/mcp.json
QASEY_DATA_ROOT=.qasey/data
QASEY_WORKSPACE_DIR=.qasey/workspaces
QASEY_ARTIFACT_DIR=.qasey/artifacts
QASEY_SANDBOX_ENABLED=false
# 固定 K8s sandbox 池启用时，地址必须保留 {ordinal} 占位符。
QASEY_SANDBOX_ENDPOINT_TEMPLATE=http://moego-qasey-sandbox-{ordinal}.moego-qasey-sandbox:4120
QASEY_SANDBOX_REPLICAS=2
QASEY_SANDBOX_MAX_SESSIONS=5
# 本机通常没有 Linux Xvfb/Openbox；K8s sandbox Pod 会显式开启。
QASEY_SANDBOX_DESKTOP_ENABLED=false
QASEY_SANDBOX_DESKTOP_DISPLAY=99
QASEY_SANDBOX_DESKTOP_WIDTH=1440
QASEY_SANDBOX_DESKTOP_HEIGHT=900
QASEY_SANDBOX_IDLE_TTL_MS=1800000
QASEY_WORKSPACE_RETENTION_MS=604800000

NAMESPACE=ns-testing
AWS_REGION=us-west-2
AWS_PROFILE=moego-development
# 无法使用 Profile 时才填写：
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
